# Personal Chinese/English VITS2 deployment, tested on JetPack 6.1 / TRT 10.4.
# Build context: repository root. Models are downloaded from JuiceFS at runtime.
ARG JP_VERSION=61
FROM bj-warehouse.tencentcloudcr.com/phanthy-motus/perception:release.261010.37994d2-jetson-jp6.1@sha256:0c8d533b94a858fd6c8571c188ead15b95645ead0f79f589272db40dff662f3a
ARG JP_VERSION
USER root
SHELL ["/bin/bash", "-e", "-o", "pipefail", "-c"]
RUN case "${JP_VERSION}" in \
      6|61|6.1) ;; \
      *) echo 'This VITS2 submission requires JetPack 6.1 / TensorRT 10.4; select JP_VERSION=6 on Darvin.' >&2; exit 1 ;; \
    esac

# Reuse the pinned image's native ROS/audio_msgs and VITS2 frontend dependencies.
# This is an application overlay: no model weights, pip upgrades or TRT builds.
WORKDIR /work
COPY perception/main.py /work/main.py
COPY perception/plugins/ /work/plugins/
COPY perception/utils/ /work/utils/
COPY perception/config.yaml /work/config.yaml
COPY perception/deploy/ /deploy/

ENV PYTHONUNBUFFERED=1
ENV RCUTILS_COLORIZED_OUTPUT=0
EXPOSE 15720 15721
ENTRYPOINT []
CMD ["/bin/bash", "-c", \
     "export LD_PRELOAD=/usr/lib/aarch64-linux-gnu/libgomp.so.1 && \
      source /opt/ros/humble/install/setup.bash && \
      source /ros_ws/install/setup.bash && \
      source /etc/dla-fallback.env && \
      exec python3 /work/main.py"]
