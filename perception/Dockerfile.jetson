# Personal MOSS TTS submission overlay on the exact JP6.1 image tested on Orin.
# Build context: personal phanthymotus repository root. No weights are copied.
# Example: docker build -f perception/Dockerfile.jetson --build-arg JP_VERSION=61 .
ARG JP_VERSION=61
FROM bj-warehouse.tencentcloudcr.com/phanthy-motus/perception:release.261010.37994d2-jetson-jp6.1@sha256:0c8d533b94a858fd6c8571c188ead15b95645ead0f79f589272db40dff662f3a
ARG JP_VERSION
ARG PYPI_MIRROR=https://pypi.tuna.tsinghua.edu.cn/simple/
USER root
SHELL ["/bin/bash", "-e", "-o", "pipefail", "-c"]
RUN test "${JP_VERSION}" = "61" || \
    { echo '[build] This MOSS candidate requires JP_VERSION=61 / TensorRT 10.4.0' >&2; exit 1; }

# Keep the validated CUDA/TRT, ROS/audio_msgs and other perception dependencies.
# Only install these basic download tools if the inherited image lacks them.
RUN if ! command -v curl >/dev/null || ! command -v bzip2 >/dev/null || \
       ! command -v tar >/dev/null || ! command -v sha256sum >/dev/null || \
       ! command -v realpath >/dev/null; then \
      apt-get update && \
      DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        curl bzip2 tar coreutils ca-certificates && \
      rm -rf /var/lib/apt/lists/*; \
    fi
RUN /usr/bin/python3 -m pip install --no-cache-dir --no-deps --only-binary=:all: \
      -i "${PYPI_MIRROR}" "sentencepiece==0.2.0"

# Reconstruct the frontend artifacts already verified on Orin. Keep NVIDIA's
# system interpreter; do not install/replace torch, numpy, CUDA or TensorRT.
COPY perception/tools/moss_prepare_frontend.sh /opt/moss-install/moss_prepare_frontend.sh
COPY perception/tools/moss_frontend_lock.py /opt/moss-install/moss_frontend_lock.py
COPY perception/tools/moss_frontend_aarch64.lock /opt/moss-install/moss_frontend_aarch64.lock
COPY perception/tools/moss_runtime_preflight.py /opt/moss-install/moss_runtime_preflight.py
RUN LD_PRELOAD=/usr/lib/aarch64-linux-gnu/libgomp.so.1 \
    LD_LIBRARY_PATH="${LD_LIBRARY_PATH}:/opt/nvidia/dla-fallback" \
    bash /opt/moss-install/moss_prepare_frontend.sh \
      --prefix /opt/moss-frontend --python /usr/bin/python3 \
      --lock /opt/moss-install/moss_frontend_aarch64.lock --build-check && \
    rm -rf /opt/moss-frontend/downloads /opt/moss-frontend/work \
      /opt/moss-frontend/mamba-root /opt/moss-frontend/mamba

# Full candidate application, including transport and original plugin registry.
# Disabled perception modules stay disabled through the supplied config.yaml.
WORKDIR /work
COPY perception/main.py /work/main.py
COPY perception/plugins/ /work/plugins/
COPY perception/utils/ /work/utils/
COPY perception/config.yaml /work/config.yaml
COPY perception/deploy/ /deploy/
COPY perception/tools/moss_trt_session.py /work/tools/moss_trt_session.py
COPY perception/tools/moss_smoke.py /work/tools/moss_smoke.py
COPY perception/tools/moss_benchmark.py /work/tools/moss_benchmark.py
COPY perception/tools/moss_platform_smoke.py /work/tools/moss_platform_smoke.py
COPY perception/tools/moss_runtime_preflight.py /work/tools/moss_runtime_preflight.py
COPY perception/tools/moss_entrypoint.sh /work/tools/moss_entrypoint.sh

# Frontend/ROS import/link checks and TRT installation evidence only. TensorRT
# driver linking requires host libraries mounted by the NVIDIA runtime and is
# checked at startup. No GPU context, model load, FST or engine build here.
RUN source /opt/ros/humble/install/setup.bash && \
    source /ros_ws/install/setup.bash && \
    LD_PRELOAD=/usr/lib/aarch64-linux-gnu/libgomp.so.1 \
    LD_LIBRARY_PATH="${LD_LIBRARY_PATH}:/opt/nvidia/dla-fallback" \
    /opt/moss-frontend/runtime-python /work/tools/moss_runtime_preflight.py --build-check

ENV PYTHONUNBUFFERED=1
ENV RCUTILS_COLORIZED_OUTPUT=0
# These defaults match the verified HTTP archive. Explicit environment overrides
# remain available for debugging; the adapter still validates graph contracts.
ENV MOSS_TRT_FRAME_PLAN=/models/moss-frame-v4/assets/plans/local_fixed_sampled_frame/local_fixed_sampled_frame.plan
ENV MOSS_TRT_FRAME_CONTRACT=/models/moss-frame-v4/assets/candidates/frame-v4/frame-contract.json
ENV MOSS_TRT_FRAME_CUDA_GRAPH=1
ENV MOSS_TRT_PROFILE=0
EXPOSE 15720 15721
ENTRYPOINT []
CMD ["/bin/bash", "/work/tools/moss_entrypoint.sh"]
