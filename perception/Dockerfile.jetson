# Jetson image for the VITS2 TensorRT TTS backend. JP6.1 is the default;
# target-specific dependencies and model archives are selected through build args.

ARG JP_VERSION=61
ARG BASE_IMAGE=bj-warehouse.tencentcloudcr.com/phanthy-motus/jetson-base:jp${JP_VERSION}-torch
ARG PYPI_MIRROR=https://pypi.tuna.tsinghua.edu.cn/simple/
ARG APT_MIRROR=mirrors.tuna.tsinghua.edu.cn

FROM ${BASE_IMAGE}
ARG JP_VERSION
ARG PYPI_MIRROR APT_MIRROR
ARG VITS2_MODEL_URL=
ARG VITS2_MODEL_SHA256=
ARG VITS_MODEL_RELEASE=lc1_male_v6_frontend_146k

USER root
RUN if [ -n "${APT_MIRROR}" ]; then \
      sed -i "s/archive.ubuntu.com/${APT_MIRROR}/g; s/ports.ubuntu.com/${APT_MIRROR}/g" /etc/apt/sources.list; \
    fi
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl ffmpeg && \
    rm -rf /var/lib/apt/lists/*

COPY perception/plugins/vits2_tts_trt/requirements.jetson.txt /tmp/vits2-requirements.txt
RUN pip3 install --no-cache-dir -i "${PYPI_MIRROR}" \
      -r /tmp/vits2-requirements.txt \
      pyyaml requests websockets websocket-client colcon-common-extensions "empy<4" && \
    python3 -c "import sys,importlib.resources as r; (setattr(r,'files',__import__('importlib_resources').files) if sys.version_info < (3,9) else None); import importlib.util,kaldifst,wetext; assert importlib.util.find_spec('tensorrt') is not None" && \
    rm -f /tmp/vits2-requirements.txt && \
    test "$(uname -m)" = aarch64 && test -f /opt/ros/humble/install/setup.bash

COPY deploy/ros-base/audio_msgs/ /ros_ws/src/audio_msgs/
RUN cd /ros_ws && \
    . /opt/ros/humble/install/setup.bash && \
    colcon build --packages-select audio_msgs --cmake-args -DCMAKE_BUILD_TYPE=Release

WORKDIR /work
COPY perception/main.py /work/main.py
COPY perception/config.yaml /work/config.yaml
COPY perception/plugins/vits2_tts_trt/ /work/plugins/vits2_tts_trt/
# Optional conversation language policy; Darvin keeps the default TTS contract.
COPY perception/config.language.yaml /work/config.language.yaml
COPY perception/plugins/vits2_tts_language/ /work/plugins/vits2_tts_language/
COPY perception/utils/__init__.py /work/utils/__init__.py
COPY perception/utils/model_downloader.py /work/utils/model_downloader.py

ENV VITS2_MODEL_URL=${VITS2_MODEL_URL} \
    VITS2_MODEL_SHA256=${VITS2_MODEL_SHA256} \
    VITS_MODEL_RELEASE=${VITS_MODEL_RELEASE}

# The release is selected automatically from JP_VERSION when URL/SHA are not
# explicitly overridden. This keeps JP5 and JP6 builds on matching plans.
RUN set -eu; \
    if [ -z "${VITS2_MODEL_URL}" ] || [ -z "${VITS2_MODEL_SHA256}" ]; then \
      case "${JP_VERSION}" in \
        61) \
          VITS2_MODEL_URL="http://172.28.4.81:34567/liaoqianqian/models/lc1-jetson/lc1_male_v6_frontend_146k_jp6_runtime.tar.gz"; \
          VITS2_MODEL_SHA256="e3a26c913285ba26d30624be50751fa27c8d6ecb8458ac1ad3b0f0d196794b42" ;; \
        511) \
          VITS2_MODEL_URL="http://172.28.4.81:34567/liaoqianqian/models/lc1-jetson/lc1_male_v6_frontend_146k_jp5_nocudnn_nojit_runtime.tar.gz"; \
          VITS2_MODEL_SHA256="4a006ceb74325d11c506f2e054faffbfce6e0ca80946ffaaa8ef5e03fc26f96a" ;; \
        *) echo "unsupported JP_VERSION=${JP_VERSION}; use 61 or 511" >&2; exit 2 ;; \
      esac; \
    fi; \
    VITS2_MODEL_URL="${VITS2_MODEL_URL}" VITS2_MODEL_SHA256="${VITS2_MODEL_SHA256}" \
      python3 -c "from utils.model_downloader import ensure_model; ensure_model('vits2', '/models/vits2-mix')"

RUN ROS_PTH="$(python3 -c 'import site; print(site.getsitepackages()[0])')/ros_ws.pth" && \
    find /ros_ws/install -name site-packages -type d \
      > "${ROS_PTH}" && \
    find /opt/ros/humble/install -name site-packages -type d \
      >> "${ROS_PTH}"

ENV LD_LIBRARY_PATH=/usr/local/lib:/ros_ws/install/audio_msgs/lib:/opt/ros/humble/install/lib:${LD_LIBRARY_PATH} \
    AMENT_PREFIX_PATH=/ros_ws/install/audio_msgs:/opt/ros/humble/install \
    CONFIG_PATH=/work/config.yaml \
    NLTK_DATA=/models/vits2-mix/nltk_data \
    EN_TN_CACHE_DIR=/models/vits2-mix/tn_cache \
    TN_CACHE_DIR=/models/vits2-mix/tn_cache \
    VITS2_FRONTEND_DATA_DIR=/models/vits2-mix/frontend_data \
    MIX_VITS_MAX_ENGINE_BYTES=67108864 \
    MIX_VITS_MAX_TEXT_TOKENS=256 \
    MIX_VITS_MAX_FRAMES=2048 \
    MIX_VITS_INFERENCE_SEED=42 \
    MIX_VITS_ENCODER_BACKEND=trt \
    MIX_VITS_ENCODER_THREADS=1 \
    MIX_VITS_CHUNK_BYTES=3200 \
    MIX_VITS_FRAME_INTERVAL_MS=70 \
    MIX_VITS_FIRST_FRAME_DELAY_MS=0 \
    MIX_VITS_SUBSCRIBER_WAIT_MS=5000 \
    MIX_VITS_SUBSCRIBER_POLL_MS=10 \
    MIX_VITS_SUBSCRIBER_SETTLE_MS=500 \
    MIX_VITS_ALLOW_FAST_DELIVERY=1 \
    DEFAULT_TTS_PLUGIN=vits2_tts_trt \
    OMP_NUM_THREADS=1 \
    MKL_NUM_THREADS=1 \
    OPENBLAS_NUM_THREADS=1

EXPOSE 15720
CMD ["/bin/bash", "-c", "source /opt/ros/humble/install/setup.bash && source /ros_ws/install/setup.bash && exec python3 /work/main.py"]
